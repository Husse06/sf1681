---
// Interaktiv figur: en ortogonal 2x2-matris, rotation eller spegling, verkar på en figur i planet.
// Visar att längder och vinklar bevaras och vilka egenvärden matrisen har.
const SKALA = 55; // pixlar per enhet
const GRANS = 3; // figuren visar [-3, 3] i båda riktningarna
const storlek = 2 * GRANS * SKALA;
const linjer = Array.from({ length: 2 * GRANS + 1 }, (_, i) => i * SKALA);
// Bokstaven F, så att en spegling syns tydligt.
const F = [
  [0.4, 0.3],
  [0.4, 2.3],
  [1.6, 2.3],
  [1.6, 1.9],
  [0.8, 1.9],
  [0.8, 1.5],
  [1.3, 1.5],
  [1.3, 1.1],
  [0.8, 1.1],
  [0.8, 0.3],
];
---

<figure class="is" data-is data-skala={SKALA} data-grans={GRANS} data-form={JSON.stringify(F)}>
  <svg
    viewBox={`0 0 ${storlek} ${storlek}`}
    role="img"
    aria-label="Bokstaven F och dess bild under en rotation eller spegling, med bilderna av standardbasvektorerna"
  >
    <g class="is__rutnat">
      {
        linjer.map((t) => (
          <>
            <line x1={t} y1="0" x2={t} y2={storlek} />
            <line x1="0" y1={t} x2={storlek} y2={t} />
          </>
        ))
      }
    </g>
    <line class="is__axel" x1="0" y1={storlek / 2} x2={storlek} y2={storlek / 2}></line>
    <line class="is__axel" x1={storlek / 2} y1="0" x2={storlek / 2} y2={storlek}></line>
    <circle class="is__cirkel" cx={storlek / 2} cy={storlek / 2} r={SKALA}></circle>
    <line class="is__spegel" data-linje="spegel"></line>
    <line class="is__normal" data-linje="normal"></line>
    <polygon class="is__form" data-form-start></polygon>
    <polygon class="is__bild" data-form-bild></polygon>
    <line class="is__pil is__pil--1" data-pil="1"></line>
    <line class="is__pil is__pil--2" data-pil="2"></line>
    <text class="is__text is__text--1" data-etikett="1">Qe₁</text>
    <text class="is__text is__text--2" data-etikett="2">Qe₂</text>
  </svg>
  <figcaption>
    <div class="is__val" role="radiogroup" aria-label="Typ av avbildning">
      <label><input type="radio" name="is-typ" value="rotation" checked data-typ /> Rotation</label>
      <label><input type="radio" name="is-typ" value="spegling" data-typ /> Spegling</label>
    </div>
    <label class="is__reglage">
      <span>θ = <output data-ut="theta"></output></span>
      <input type="range" min="-180" max="180" step="5" value="60" data-theta aria-label="Vinkeln θ i grader" />
    </label>
    <dl class="is__varden">
      <div><dt>Q</dt><dd class="is__matris" data-ut="Q"></dd></div>
      <div><dt>det Q</dt><dd data-ut="det"></dd></div>
      <div><dt>Egenvärden</dt><dd data-ut="lambda"></dd></div>
      <div><dt>⟨Qe₁ | Qe₂⟩</dt><dd data-ut="ip"></dd></div>
    </dl>
    <p class="is__besked" data-ut="besked" aria-live="polite"></p>
    <p class="is__tips">
      Den grå bokstaven är utgångsläget och den färgade dess bild. Pilarna är kolonnerna Qe₁ och Qe₂. Den streckade
      cirkeln är enhetscirkeln.
    </p>
  </figcaption>
</figure>

<style>
  .is {
    margin-block: 1.5rem;
    max-width: 26rem;
  }
  .is svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
  }
  .is__rutnat line {
    stroke: var(--fig-standard);
    stroke-width: 1;
  }
  .is__axel {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .is__cirkel {
    fill: none;
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }
  .is__spegel {
    stroke: var(--fig-b2);
    stroke-width: 5;
    opacity: 0.5;
  }
  .is__normal {
    stroke: var(--fig-b1);
    stroke-width: 3;
    stroke-dasharray: 8 6;
    opacity: 0.6;
  }
  .is__form {
    fill: var(--sl-color-gray-5);
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .is__bild {
    fill: var(--sl-color-accent-low);
    fill-opacity: 0.75;
    stroke: var(--sl-color-accent);
    stroke-width: 2;
  }
  .is__pil {
    stroke-width: 3;
    stroke-linecap: round;
  }
  .is__pil--1 {
    stroke: var(--fig-b1);
  }
  .is__pil--2 {
    stroke: var(--fig-v);
  }
  .is__text {
    font-size: 16px;
    font-weight: 700;
    user-select: none;
  }
  .is__text--1 {
    fill: var(--fig-b1);
  }
  .is__text--2 {
    fill: var(--fig-v);
  }
  .is__val {
    display: flex;
    gap: 1.25rem;
    margin-block: 0.75rem 0.25rem;
    font-size: var(--sl-text-sm);
  }
  .is__val label,
  .is__val input {
    margin: 0;
  }
  .is__val input {
    accent-color: var(--sl-color-accent);
  }
  .is__reglage {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-block: 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .is__reglage > * {
    margin: 0;
  }
  .is__reglage input {
    width: 100%;
    accent-color: var(--sl-color-accent);
  }
  .is__reglage output {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .is__varden {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
    align-items: center;
    margin: 0;
    font-size: var(--sl-text-sm);
  }
  .is__varden div {
    display: contents;
  }
  .is__varden dt {
    font-weight: 600;
  }
  .is__varden dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .is__varden .is__matris {
    justify-self: start;
    white-space: pre;
    border-inline: 2px solid var(--sl-color-gray-3);
    border-radius: 0.25rem;
    padding: 0 0.4rem;
    line-height: 1.3;
    text-align: right;
  }
  .is__besked {
    min-height: 3em;
    margin-block: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text-accent);
  }
  .is__tips {
    margin-block: 0.25rem 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
</style>

<script>
  type Punkt = { x: number; y: number };
  const tal = (t: number) => {
    const avrundat = Math.round(t * 100) / 100;
    return (Object.is(avrundat, -0) ? 0 : avrundat).toLocaleString('sv-SE', { maximumFractionDigits: 2 });
  };

  for (const figur of document.querySelectorAll<HTMLElement>('[data-is]')) {
    const skala = Number(figur.dataset.skala);
    const grans = Number(figur.dataset.grans);
    const form: [number, number][] = JSON.parse(figur.dataset.form!);
    const ut = (namn: string) => figur.querySelector<HTMLElement>(`[data-ut="${namn}"]`)!;
    const reglage = figur.querySelector<HTMLInputElement>('[data-theta]')!;
    const typer = [...figur.querySelectorAll<HTMLInputElement>('[data-typ]')];
    // Unika namn på radioknapparna om figuren används flera gånger på samma sida.
    const namn = `is-typ-${Math.random().toString(36).slice(2)}`;
    typer.forEach((t) => (t.name = namn));

    const tillSkarm = (p: Punkt) => ({ x: (p.x + grans) * skala, y: (grans - p.y) * skala });
    const satt = (el: Element, p: Punkt, q: Punkt) => {
      const a = tillSkarm(p);
      const b = tillSkarm(q);
      el.setAttribute('x1', String(a.x));
      el.setAttribute('y1', String(a.y));
      el.setAttribute('x2', String(b.x));
      el.setAttribute('y2', String(b.y));
    };
    const gom = (el: Element) => ['x1', 'y1', 'x2', 'y2'].forEach((a) => el.removeAttribute(a));
    const polygon = (pts: Punkt[]) =>
      pts
        .map(tillSkarm)
        .map((s) => `${s.x},${s.y}`)
        .join(' ');

    const rita = () => {
      const grader = Number(reglage.value);
      const t = (grader * Math.PI) / 180;
      const c = Math.cos(t);
      const s = Math.sin(t);
      const spegling = typer.find((x) => x.checked)?.value === 'spegling';
      // Kolonnerna i Q.
      const q1 = { x: c, y: s };
      const q2 = spegling ? { x: s, y: -c } : { x: -s, y: c };
      const Q = (p: Punkt): Punkt => ({ x: q1.x * p.x + q2.x * p.y, y: q1.y * p.x + q2.y * p.y });

      ut('theta').textContent = `${grader}°`;
      const start = form.map(([x, y]) => ({ x, y }));
      figur.querySelector('[data-form-start]')!.setAttribute('points', polygon(start));
      figur.querySelector('[data-form-bild]')!.setAttribute('points', polygon(start.map(Q)));

      const o = { x: 0, y: 0 };
      satt(figur.querySelector('[data-pil="1"]')!, o, q1);
      satt(figur.querySelector('[data-pil="2"]')!, o, q2);
      for (const [i, q] of [
        ['1', q1],
        ['2', q2],
      ] as const) {
        const el = figur.querySelector(`[data-etikett="${i}"]`)!;
        const p = tillSkarm({ x: q.x * 1.35, y: q.y * 1.35 });
        el.setAttribute('x', String(p.x - 14));
        el.setAttribute('y', String(p.y + 6));
      }

      const spegel = figur.querySelector('[data-linje="spegel"]')!;
      const normal = figur.querySelector('[data-linje="normal"]')!;
      if (spegling) {
        const u = { x: Math.cos(t / 2), y: Math.sin(t / 2) };
        satt(spegel, { x: -u.x * 10, y: -u.y * 10 }, { x: u.x * 10, y: u.y * 10 });
        satt(normal, { x: u.y * 10, y: -u.x * 10 }, { x: -u.y * 10, y: u.x * 10 });
      } else {
        gom(spegel);
        gom(normal);
      }

      ut('Q').textContent = `${tal(q1.x)}  ${tal(q2.x)}\n${tal(q1.y)}  ${tal(q2.y)}`;
      ut('det').textContent = spegling ? '−1' : '1';
      ut('ip').textContent = tal(q1.x * q2.x + q1.y * q2.y);

      let besked: string;
      if (spegling) {
        ut('lambda').textContent = '1 och −1';
        besked = `Spegling i linjen med vinkeln ${tal(grader / 2)}° mot x-axeln. Linjen är egenrummet till 1 och normalen egenrummet till −1. De är vinkelräta. Bokstaven blir spegelvänd, eftersom det Q = −1.`;
      } else if (grader === 0) {
        ut('lambda').textContent = '1 (dubbelt)';
        besked = 'Q = I. Alla vektorer är egenvektorer.';
      } else if (Math.abs(grader) === 180) {
        ut('lambda').textContent = '−1 (dubbelt)';
        besked = 'Q = −I, ett halvt varv. Alla vektorer är egenvektorer med egenvärdet −1.';
      } else {
        ut('lambda').textContent = `${tal(c)} ± ${tal(Math.abs(s))}i`;
        besked = `Rotation med ${grader}°. Egenvärdena e^{±iθ} har belopp 1 men är inte reella, så ingen linje i R² avbildas på sig själv. Egenvektorerna (1, ∓i) är komplexa.`;
      }
      besked += ' Längder och vinklar bevaras: kolonnerna har längd 1 och är ortogonala.';
      ut('besked').textContent = besked;
    };

    reglage.addEventListener('input', rita);
    typer.forEach((t) => t.addEventListener('change', rita));
    rita();
  }
</script>
