---
// Interaktiv figur: en linjär avbildning R^2 -> R^2, med kärna till vänster och bild till höger.
const SKALA = 40; // pixlar per enhet
const GRANS = 4; // varje panel visar [-4, 4] i båda riktningarna
const storlek = 2 * GRANS * SKALA;
const linjer = Array.from({ length: 2 * GRANS + 1 }, (_, i) => (i - GRANS + GRANS) * SKALA);
---

<figure class="kb" data-kb data-skala={SKALA} data-grans={GRANS}>
  <div class="kb__paneler">
    {
      ['kalla', 'mal'].map((panel) => (
        <div class="kb__panel">
          <p class="kb__rubrik">{panel === 'kalla' ? 'V = R²' : 'W = R²'}</p>
          <svg
            viewBox={`0 0 ${storlek} ${storlek}`}
            data-panel={panel}
            role="group"
            aria-label={panel === 'kalla' ? 'Källrummet med kärnan' : 'Målrummet med bilden'}
          >
            <rect class="kb__fyllning" data-fyllning width={storlek} height={storlek} />
            <g class="kb__rutnat">
              {linjer.map((t) => (
                <>
                  <line x1={t} y1="0" x2={t} y2={storlek} />
                  <line x1="0" y1={t} x2={storlek} y2={t} />
                </>
              ))}
            </g>
            <line class="kb__axel" x1="0" y1={storlek / 2} x2={storlek} y2={storlek / 2} />
            <line class="kb__axel" x1={storlek / 2} y1="0" x2={storlek / 2} y2={storlek} />
            <line class="kb__delrum" data-delrum />
            {panel === 'kalla' && <line class="kb__parallell" data-parallell />}
            <circle class="kb__origo" data-origo r="6" cx={storlek / 2} cy={storlek / 2} />
            {panel === 'mal' && (
              <>
                <line class="kb__pil kb__pil--a1" data-pil="a1" />
                <line class="kb__pil kb__pil--a2" data-pil="a2" />
                <line class="kb__pil kb__pil--y" data-pil="y" />
                <g class="kb__punkt kb__punkt--y" data-fast="y">
                  <circle r="6" />
                  <text dx="10" dy="-9">L(x)</text>
                </g>
              </>
            )}
            {panel === 'kalla' && <line class="kb__pil kb__pil--x" data-pil="x" />}
            {(panel === 'kalla'
              ? [['x', 'x']]
              : [
                  ['a1', 'L(e₁)'],
                  ['a2', 'L(e₂)'],
                ]
            ).map(([namn, etikett]) => (
              <g
                class={`kb__handtag kb__punkt--${namn}`}
                data-handtag={namn}
                tabindex="0"
                role="slider"
                aria-label={`Flytta ${etikett}. Piltangenterna flyttar en halv enhet.`}
              >
                <circle class="kb__traff" r="22" />
                <circle r="7" />
                <text dx="10" dy="-9">
                  {etikett}
                </text>
              </g>
            ))}
          </svg>
        </div>
      ))
    }
  </div>
  <figcaption>
    <p class="kb__tips">
      Punkterna L(e₁), L(e₂) och x är flyttbara och fästs vid närmaste halva enhet.
    </p>
    <dl class="kb__varden">
      <div><dt>Matris</dt><dd class="kb__matris" data-ut="A"></dd></div>
      <div><dt>dim ker L</dt><dd data-ut="ker"></dd></div>
      <div><dt>dim im L</dt><dd data-ut="im"></dd></div>
    </dl>
    <p class="kb__besked" data-ut="besked" aria-live="polite"></p>
  </figcaption>
</figure>

<style>
  .kb {
    margin-block: 1.5rem;
  }
  .kb__paneler {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
  }
  .kb__panel {
    margin: 0;
  }
  .kb__rubrik {
    margin: 0 0 0.25rem;
    font-weight: 600;
  }
  .kb svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
  }
  .kb__fyllning {
    fill: var(--fig-b2);
    opacity: 0;
  }
  .kb__rutnat line {
    stroke: var(--fig-standard);
    stroke-width: 1;
  }
  .kb__axel {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.5;
  }
  .kb__delrum {
    stroke: var(--fig-b2);
    stroke-width: 5;
    opacity: 0.75;
  }
  .kb__parallell {
    stroke: var(--fig-v);
    stroke-width: 2;
    stroke-dasharray: 6 5;
  }
  .kb__origo {
    fill: var(--fig-b2);
  }
  .kb__pil {
    stroke-width: 3;
  }
  .kb__pil--a1 {
    stroke: var(--fig-b1);
  }
  .kb__pil--a2 {
    stroke: var(--fig-b1);
    stroke-dasharray: 8 5;
  }
  .kb__pil--x,
  .kb__pil--y {
    stroke: var(--fig-v);
  }
  .kb__handtag {
    cursor: grab;
    touch-action: none;
    outline: none;
  }
  .kb__handtag:focus-visible circle:not(.kb__traff) {
    stroke: var(--sl-color-white);
    stroke-width: 3;
  }
  .kb__traff {
    fill: transparent;
  }
  .kb text {
    font-size: 16px;
    font-weight: 700;
    user-select: none;
  }
  .kb__punkt--a1,
  .kb__punkt--a2 {
    fill: var(--fig-b1);
  }
  .kb__punkt--x,
  .kb__punkt--y {
    fill: var(--fig-v);
  }
  .kb__tips {
    margin-block: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .kb__varden {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }
  .kb__varden div {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .kb__varden dt {
    font-weight: 600;
  }
  .kb__varden dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .kb__varden .kb__matris {
    white-space: pre;
    border-inline: 2px solid var(--sl-color-gray-3);
    border-radius: 0.25rem;
    padding: 0 0.4rem;
    line-height: 1.3;
    text-align: right;
  }
  .kb__besked {
    min-height: 3em;
    margin-block: 0.5rem 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-text-accent);
  }
</style>

<script>
  type Punkt = { x: number; y: number };
  const tal = (t: number) => {
    const avrundat = Math.round(t * 100) / 100;
    return (Object.is(avrundat, -0) ? 0 : avrundat).toLocaleString('sv-SE', {
      maximumFractionDigits: 2,
    });
  };
  const arNoll = (p: Punkt) => p.x === 0 && p.y === 0;

  for (const figur of document.querySelectorAll<HTMLElement>('[data-kb]')) {
    const skala = Number(figur.dataset.skala);
    const grans = Number(figur.dataset.grans);
    const kalla = figur.querySelector<SVGSVGElement>('[data-panel="kalla"]')!;
    const mal = figur.querySelector<SVGSVGElement>('[data-panel="mal"]')!;
    const ut = (namn: string) => figur.querySelector<HTMLElement>(`[data-ut="${namn}"]`)!;
    const punkter: Record<string, Punkt> = {
      a1: { x: 2, y: 1 },
      a2: { x: -1, y: -0.5 },
      x: { x: 2, y: 1 },
    };

    const tillSkarm = (p: Punkt) => ({
      x: (p.x + grans) * skala,
      y: (grans - p.y) * skala,
    });
    const fastna = (t: number) => Math.max(-grans, Math.min(grans, Math.round(t * 2) / 2));

    const satt = (el: Element | null, p: Punkt, q: Punkt) => {
      if (!el) return;
      const a = tillSkarm(p);
      const b = tillSkarm(q);
      el.setAttribute('x1', String(a.x));
      el.setAttribute('y1', String(a.y));
      el.setAttribute('x2', String(b.x));
      el.setAttribute('y2', String(b.y));
    };
    const linje = (el: Element | null, punkt: Punkt, riktning: Punkt | null) => {
      if (!el) return;
      if (!riktning) {
        el.removeAttribute('x1');
        el.removeAttribute('y1');
        el.removeAttribute('x2');
        el.removeAttribute('y2');
        return;
      }
      const langd = Math.hypot(riktning.x, riktning.y);
      const d = { x: (riktning.x / langd) * 20, y: (riktning.y / langd) * 20 };
      satt(el, { x: punkt.x - d.x, y: punkt.y - d.y }, { x: punkt.x + d.x, y: punkt.y + d.y });
    };

    const rita = () => {
      const { a1, a2, x } = punkter;
      const y = { x: x.x * a1.x + x.y * a2.x, y: x.x * a1.y + x.y * a2.y };
      const o = { x: 0, y: 0 };
      const det = a1.x * a2.y - a2.x * a1.y;
      const rang = det !== 0 ? 2 : arNoll(a1) && arNoll(a2) ? 0 : 1;

      for (const namn of Object.keys(punkter)) {
        const s = tillSkarm(punkter[namn]);
        const handtag = figur.querySelector(`[data-handtag="${namn}"]`)!;
        handtag.setAttribute('transform', `translate(${s.x} ${s.y})`);
        handtag.setAttribute('aria-valuetext', `(${tal(punkter[namn].x)}, ${tal(punkter[namn].y)})`);
        satt(figur.querySelector(`[data-pil="${namn}"]`), o, punkter[namn]);
      }
      satt(figur.querySelector('[data-pil="y"]'), o, y);
      const s = tillSkarm(y);
      const synlig = Math.abs(y.x) <= grans && Math.abs(y.y) <= grans;
      const fast = figur.querySelector('[data-fast="y"]')!;
      fast.setAttribute('transform', `translate(${s.x} ${s.y})`);
      fast.setAttribute('visibility', synlig ? 'visible' : 'hidden');

      // Rang 1: kärnan är vinkelrät mot en nollskild rad och bilden spänns upp av en nollskild kolumn.
      const rad = a1.x !== 0 || a2.x !== 0 ? { x: a1.x, y: a2.x } : { x: a1.y, y: a2.y };
      const karna = rang === 1 ? { x: -rad.y, y: rad.x } : null;
      const bild = rang === 1 ? (arNoll(a1) ? a2 : a1) : null;
      linje(kalla.querySelector('[data-delrum]'), o, karna);
      linje(kalla.querySelector('[data-parallell]'), x, karna);
      linje(mal.querySelector('[data-delrum]'), o, bild);

      kalla.querySelector('[data-fyllning]')!.setAttribute('opacity', rang === 0 ? '0.25' : '0');
      mal.querySelector('[data-fyllning]')!.setAttribute('opacity', rang === 2 ? '0.25' : '0');

      ut('A').textContent = `${tal(a1.x)}  ${tal(a2.x)}\n${tal(a1.y)}  ${tal(a2.y)}`;
      ut('ker').textContent = String(2 - rang);
      ut('im').textContent = String(rang);
      ut('besked').textContent = [
        'Allt skickas på origo. Kärnan är hela V och bilden bara nollvektorn.',
        'Kärnan och bilden är linjer. Hela den streckade linjen genom x skickas på samma punkt L(x).',
        'Kärnan är bara nollvektorn och bilden är hela W. L är en isomorfi.',
      ][rang];
    };

    for (const handtag of figur.querySelectorAll<SVGGElement>('[data-handtag]')) {
      const namn = handtag.dataset.handtag!;
      const svg = handtag.ownerSVGElement!;
      const flytta = (e: PointerEvent) => {
        const ruta = svg.getBoundingClientRect();
        const faktor = (2 * grans * skala) / ruta.width;
        const px = (e.clientX - ruta.left) * faktor;
        const py = (e.clientY - ruta.top) * faktor;
        punkter[namn] = { x: fastna(px / skala - grans), y: fastna(grans - py / skala) };
        rita();
      };
      handtag.addEventListener('pointerdown', (e) => {
        handtag.setPointerCapture(e.pointerId);
        handtag.addEventListener('pointermove', flytta);
      });
      const slapp = () => handtag.removeEventListener('pointermove', flytta);
      handtag.addEventListener('pointerup', slapp);
      handtag.addEventListener('pointercancel', slapp);
      handtag.addEventListener('keydown', (e) => {
        const steg: Record<string, Punkt> = {
          ArrowLeft: { x: -0.5, y: 0 },
          ArrowRight: { x: 0.5, y: 0 },
          ArrowUp: { x: 0, y: 0.5 },
          ArrowDown: { x: 0, y: -0.5 },
        };
        const d = steg[e.key];
        if (!d) return;
        e.preventDefault();
        const p = punkter[namn];
        punkter[namn] = { x: fastna(p.x + d.x), y: fastna(p.y + d.y) };
        rita();
      });
    }

    rita();
  }
</script>
