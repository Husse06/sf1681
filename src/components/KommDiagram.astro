---
// Kommutativt diagram. Pilarna ritas som SVG och formlerna renderas med KaTeX när sidan byggs,
// eftersom formler i .astro-komponenter annars inte går genom rehype-katex.
import katex from 'katex';

interface Nod {
  x: number;
  y: number;
  tex: string;
  /** Halva bredden som pilen ska hålla sig borta från, i pixlar. */
  b?: number;
}
interface Pil {
  fran: string;
  till: string;
  tex?: string;
  sida?: 'over' | 'under' | 'vanster' | 'hoger';
  /** Extra förskjutning av etiketten, i pixlar. */
  dx?: number;
  dy?: number;
}
interface Props {
  bredd: number;
  hojd: number;
  noder: Record<string, Nod>;
  pilar: Pil[];
  beskrivning: string;
}

const { bredd, hojd, noder, pilar, beskrivning } = Astro.props;

const HALVHOJD = 14;
const AVSTAND = 7;
const SPETS = 8;

const formel = (tex: string) => katex.renderToString(tex, { throwOnError: true, output: 'html' });
const procent = (t: number, helhet: number) => `${((t / helhet) * 100).toFixed(2)}%`;

const linjer = pilar.map((pil) => {
  const a = noder[pil.fran];
  const c = noder[pil.till];
  const dx = c.x - a.x;
  const dy = c.y - a.y;
  const langd = Math.hypot(dx, dy);
  // Hur långt längs pilen man måste gå för att lämna rektangeln runt en nod.
  const utanfor = (nod: Nod) =>
    Math.min(
      dx === 0 ? Infinity : (nod.b ?? 14) / Math.abs(dx),
      dy === 0 ? Infinity : HALVHOJD / Math.abs(dy),
    );
  const s = utanfor(a);
  const t = 1 - utanfor(c);
  const start = { x: a.x + s * dx, y: a.y + s * dy };
  const slut = { x: a.x + t * dx, y: a.y + t * dy };
  const vinkel = Math.atan2(dy, dx);
  const spets = [vinkel + 2.7, vinkel - 2.7].map((v) => ({
    x: slut.x + SPETS * Math.cos(v),
    y: slut.y + SPETS * Math.sin(v),
  }));
  const mitt = { x: (start.x + slut.x) / 2, y: (start.y + slut.y) / 2 };
  const forskjutning = {
    over: { x: 0, y: -AVSTAND },
    under: { x: 0, y: AVSTAND },
    vanster: { x: -AVSTAND, y: 0 },
    hoger: { x: AVSTAND, y: 0 },
  }[pil.sida ?? 'over'];
  return {
    d: `M${start.x} ${start.y}L${slut.x} ${slut.y}`,
    spets: `M${spets[0].x} ${spets[0].y}L${slut.x} ${slut.y}L${spets[1].x} ${spets[1].y}`,
    tex: pil.tex,
    sida: pil.sida ?? 'over',
    x: mitt.x + forskjutning.x + (pil.dx ?? 0),
    y: mitt.y + forskjutning.y + (pil.dy ?? 0),
    langd,
  };
});
---

<figure
  class="kd"
  role="img"
  aria-label={beskrivning}
  style={`max-width: ${bredd}px; aspect-ratio: ${bredd} / ${hojd};`}
>
  <svg viewBox={`0 0 ${bredd} ${hojd}`} aria-hidden="true">
    {
      linjer.map((l) => (
        <>
          <path d={l.d} />
          <path d={l.spets} />
        </>
      ))
    }
  </svg>
  {
    Object.values(noder).map((nod) => (
      <span
        class="kd__nod"
        style={`left: ${procent(nod.x, bredd)}; top: ${procent(nod.y, hojd)};`}
        set:html={formel(nod.tex)}
      />
    ))
  }
  {
    linjer
      .filter((l) => l.tex)
      .map((l) => (
        <span
          class={`kd__etikett kd__etikett--${l.sida}`}
          style={`left: ${procent(l.x, bredd)}; top: ${procent(l.y, hojd)};`}
          set:html={formel(l.tex!)}
        />
      ))
  }
</figure>

<style>
  .kd {
    position: relative;
    width: 100%;
    margin: 1.25rem auto;
  }
  .kd svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .kd__nod,
  .kd__etikett {
    position: absolute;
    margin: 0;
    line-height: 1;
    white-space: nowrap;
  }
  .kd__nod {
    transform: translate(-50%, -50%);
    font-size: 1rem;
  }
  .kd__etikett {
    font-size: 0.72rem;
  }
  .kd__etikett--over {
    transform: translate(-50%, -100%);
  }
  .kd__etikett--under {
    transform: translate(-50%, 0);
  }
  .kd__etikett--vanster {
    transform: translate(-100%, -50%);
  }
  .kd__etikett--hoger {
    transform: translate(0, -50%);
  }
</style>
